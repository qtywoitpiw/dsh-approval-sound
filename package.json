{
  "name": "dsh-approval-sound",
  "version": "1.0.0",
  "type": "module",
  "description": "Plays a chime in the DSH web UI when a tool permission approval is waiting, with an on/off switch in Settings → General.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qtywoitpiw/dsh-approval-sound.git"
  },
  "homepage": "https://github.com/qtywoitpiw/dsh-approval-sound#readme",
  "bugs": {
    "url": "https://github.com/qtywoitpiw/dsh-approval-sound/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "permission",
    "notification",
    "chime",
    "sound"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
